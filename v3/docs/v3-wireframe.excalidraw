      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1006,
      "y": 3390,
      "width": 126.50000000000001,
      "height": 150,
      "text": "every item above is a\ncard with independent\nstrength + due date.\n\nThe scheduler assembles\ntoday's session:\n\n  make-up → chain →\n  review → learn\n\nThe learner never picks\nthe question.",
      "originalText": "every item above is a\ncard with independent\nstrength + due date.\n\nThe scheduler assembles\ntoday's session:\n\n  make-up → chain →\n  review → learn\n\nThe learner never picks\nthe question.",
      "fontSize": 10,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
