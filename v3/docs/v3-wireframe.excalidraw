      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "id": "el-1392",
      "angle": 0,
      "strokeColor": "#918f86",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 11031167,
      "version": 1,
      "versionNonce": 145887497,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 354,
      "y": 16602,
      "width": 610.5,
      "height": 12.5,
      "text": "Only rare action: “Rebuild atom cache from events” — confirm modal, audit-logged. It re-derives, never invents.",
      "originalText": "Only rare action: “Rebuild atom cache from events” — confirm modal, audit-logged. It re-derives, never invents.",
      "fontSize": 10,
      "fontFamily": 5,
      "textAlign": "left",
