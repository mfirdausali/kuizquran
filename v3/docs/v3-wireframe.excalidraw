      "type": "text",
      "x": 1004,
      "y": 17180,
      "width": 222.75000000000003,
      "height": 33.75,
      "text": "Overrides are an ADDITIVE layer — the base\ncorpus is never mutated. Every override needs\na typed rationale and is attributed forever.",
      "originalText": "Overrides are an ADDITIVE layer — the base\ncorpus is never mutated. Every override needs\na typed rationale and is attributed forever.",
      "fontSize": 9,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
