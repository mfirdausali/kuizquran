      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 100,
      "y": 24986,
      "width": 822.2500000000001,
      "height": 48.75,
      "text": "The quiz alone can take you to CUED RECALL of a full page: every word produced in order, from a blank ayah.\nIt cannot, today, prove FREE RECALL — reciting from memory with nothing on screen. The word bank is always present.\nThat gap is one unbuilt feature (v2-D05's deferred \"hard mode\"), not a flaw in the method.",
      "originalText": "The quiz alone can take you to CUED RECALL of a full page: every word produced in order, from a blank ayah.\nIt cannot, today, prove FREE RECALL — reciting from memory with nothing on screen. The word bank is always present.\nThat gap is one unbuilt feature (v2-D05's deferred \"hard mode\"), not a flaw in the method.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
