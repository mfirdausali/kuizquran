      "width": 350,
      "height": 114
    },
    {
      "id": "el-1078",
      "angle": 0,
      "strokeColor": "#7a4d0d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
