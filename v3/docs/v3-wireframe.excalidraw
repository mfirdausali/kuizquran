      "x": 1272,
      "y": 21592,
      "width": 310.20000000000005,
      "height": 135,
      "text": "AVATARS ARE GEOMETRIC PATTERNS\n24 khatam / 8-point-star / arabesque tiles in 6\ncolourways. NO photos, NO faces, NO creature\nmascots — aniconism-safe BY CONSTRUCTION\nrather than by moderation.\n\nThis also removes an entire moderation category\n(inappropriate profile photos) before it can\nexist.",
      "originalText": "AVATARS ARE GEOMETRIC PATTERNS\n24 khatam / 8-point-star / arabesque tiles in 6\ncolourways. NO photos, NO faces, NO creature\nmascots — aniconism-safe BY CONSTRUCTION\nrather than by moderation.\n\nThis also removes an entire moderation category\n(inappropriate profile photos) before it can\nexist.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
