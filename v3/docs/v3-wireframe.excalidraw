      "height": 219
    },
    {
      "id": "el-2728",
      "angle": 0,
      "strokeColor": "#7a4d0d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 21610951,
      "version": 1,
      "versionNonce": 285805441,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1272,
      "y": 32572,
      "width": 323.40000000000003,
      "height": 195,
      "text": "GEO-PRICING (v3-D07)\n  MY IP  → RM20/mo  ·  RM500 lifetime\n  else   → USD10/mo ·  USD200 lifetime\n\nIP sets the DEFAULT; the learner can change\nregion. No VPN enforcement theatre — a user\npaying USD10 instead of RM20 is a rounding error,\nand strict IP+card-country locking would shut out\nthe Malaysian diaspora, who are the segment MOST\nable to pay.\n\nStore the chosen region on the account, not per\nsession, so travel doesn't reprice anyone.",
      "originalText": "GEO-PRICING (v3-D07)\n  MY IP  → RM20/mo  ·  RM500 lifetime\n  else   → USD10/mo ·  USD200 lifetime\n\nIP sets the DEFAULT; the learner can change\nregion. No VPN enforcement theatre — a user\npaying USD10 instead of RM20 is a rounding error,\nand strict IP+card-country locking would shut out\nthe Malaysian diaspora, who are the segment MOST\nable to pay.\n\nStore the chosen region on the account, not per\nsession, so travel doesn't reprice anyone.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "id": "el-2729",
      "angle": 0,
