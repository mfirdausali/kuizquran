      "type": "text",
      "x": 812,
      "y": 5008,
      "width": 290.40000000000003,
      "height": 60,
      "text": "Time budget (~6–8 min) TRIMS the queue —\nbut gates and make-ups are NEVER dropped.\nThey define the minimum viable session, so a\nsession is always finishable.",
      "originalText": "Time budget (~6–8 min) TRIMS the queue —\nbut gates and make-ups are NEVER dropped.\nThey define the minimum viable session, so a\nsession is always finishable.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
