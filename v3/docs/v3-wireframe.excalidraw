      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 170,
      "y": 31110,
      "width": 456.50000000000006,
      "height": 37.5,
      "text": "Escalate the answer width (3 → 5 → 8 words) rather than drop the question.\nMeasured on seams: 1-word granularity admits only 30/110; the ladder admits 110/110\nwith ZERO starvation.",
      "originalText": "Escalate the answer width (3 → 5 → 8 words) rather than drop the question.\nMeasured on seams: 1-word granularity admits only 30/110; the ladder admits 110/110\nwith ZERO starvation.",
      "fontSize": 10,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
