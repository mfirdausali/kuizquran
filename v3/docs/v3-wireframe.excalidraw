      "type": "rectangle",
      "x": 770,
      "y": 27522,
      "width": 660,
      "height": 300
    },
    {
      "id": "el-2434",
      "angle": 0,
      "strokeColor": "#6c5bb8",
      "backgroundColor": "transparent",
