      "width": 266.20000000000005,
      "height": 13.75,
      "text": "THE SHUTDOWN RULE — pre-committed, in the UI",
      "originalText": "THE SHUTDOWN RULE — pre-committed, in the UI",
      "fontSize": 11,
      "fontFamily": 5,
