      "width": 340,
      "height": 174
    },
    {
      "id": "el-626",
      "angle": 0,
      "strokeColor": "#7a4d0d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
