    },
    {
      "id": "el-2262",
      "angle": 0,
      "strokeColor": "#5f5d55",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 17920697,
      "version": 1,
      "versionNonce": 237001727,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 922,
      "y": 24418,
      "width": 313.5,
      "height": 50,
      "text": "\"TURN IT OFF when, at 90 days with adequate power:\n P(recall@10y) Δ ≤ 0 while ANY engagement metric Δ > 0.\n Engagement without retention is addiction, not learning.\n NEUTRAL at 180 days → also OFF (complexity is a cost).\"",
      "originalText": "\"TURN IT OFF when, at 90 days with adequate power:\n P(recall@10y) Δ ≤ 0 while ANY engagement metric Δ > 0.\n Engagement without retention is addiction, not learning.\n NEUTRAL at 180 days → also OFF (complexity is a cost).\"",
      "fontSize": 10,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
