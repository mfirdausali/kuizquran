      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 364,
      "y": 16564,
      "width": 643.5,
      "height": 12.5,
      "text": "Events tab is READ-ONLY. Atoms are a fold of the log — staff may never edit a graded event or set a strength by hand.",
      "originalText": "Events tab is READ-ONLY. Atoms are a fold of the log — staff may never edit a graded event or set a strength by hand.",
