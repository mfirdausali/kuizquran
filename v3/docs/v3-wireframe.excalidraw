    {
      "id": "el-2595",
      "angle": 0,
      "strokeColor": "#5f5d55",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
