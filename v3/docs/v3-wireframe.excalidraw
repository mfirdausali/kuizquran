      "type": "text",
      "x": 100,
      "y": 30232,
      "width": 393.25000000000006,
      "height": 41.25,
      "text": "lap  = floor(k / L)        slot = k % L\nlane = lanes[ lapPerm(siteKey, lap, L)[slot] ]\nidx  = ( stride(N)*lap + mix32(fnv1a(siteKey+\"#\"+lane)) % N ) % N",
      "originalText": "lap  = floor(k / L)        slot = k % L\nlane = lanes[ lapPerm(siteKey, lap, L)[slot] ]\nidx  = ( stride(N)*lap + mix32(fnv1a(siteKey+\"#\"+lane)) % N ) % N",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
