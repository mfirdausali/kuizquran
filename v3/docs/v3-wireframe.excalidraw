      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1272,
      "y": 22652,
      "width": 310.20000000000005,
      "height": 210,
      "text": "\"WORD CARE\", not a report card\nSame data a grading UI would show — per-word\nfailure, confusion pairs, latency — but framed\nas TENDING, with the fix already scheduled.\n\nNo percentages. No scores. No red text. The\nonly coral on the screen is a single small dot.\n\nAnd it ALWAYS shows a \"getting steadier\"\nsection: if nothing is improving it says\n\"Every word here is either settling or being\ntended. Well kept.\" A diagnostic screen that\ncan only ever accuse is one people stop\nopening.",
      "originalText": "\"WORD CARE\", not a report card\nSame data a grading UI would show — per-word\nfailure, confusion pairs, latency — but framed\nas TENDING, with the fix already scheduled.\n\nNo percentages. No scores. No red text. The\nonly coral on the screen is a single small dot.\n\nAnd it ALWAYS shows a \"getting steadier\"\nsection: if nothing is improving it says\n\"Every word here is either settling or being\ntended. Well kept.\" A diagnostic screen that\ncan only ever accuse is one people stop\nopening.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
