      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 136,
      "y": 11112,
      "width": 484.00000000000006,
      "height": 55,
      "text": "105 of 111 Yusuf verses SPAN MORE THAN ONE LINE (measured, not assumed).\nSo `line` can only mean THE FIRST LINE the verse appears on — never \"the line\".\nAyah 1 = page 235 line 11 (Yusuf starts mid-page); ayah 5 = page 236 line 1.\nIf you need true line-level drilling later, the unit is the WORD, not the verse.",
      "originalText": "105 of 111 Yusuf verses SPAN MORE THAN ONE LINE (measured, not assumed).\nSo `line` can only mean THE FIRST LINE the verse appears on — never \"the line\".\nAyah 1 = page 235 line 11 (Yusuf starts mid-page); ayah 5 = page 236 line 1.\nIf you need true line-level drilling later, the unit is the WORD, not the verse.",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
