    {
      "id": "el-543",
      "angle": 0,
      "strokeColor": "#712b13",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
