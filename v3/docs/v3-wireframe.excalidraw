      "width": 380,
      "height": 174
    },
    {
      "id": "el-3055",
      "angle": 0,
      "strokeColor": "#7a4d0d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 24200464,
      "version": 1,
      "versionNonce": 320051824,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 772,
      "y": 37072,
      "width": 283.8,
      "height": 150,
      "text": "SCOPE WARNING\nThe recommender (step 30) is the piece most\nlikely to eat the project. It only becomes\nmeaningful once a learner has 2+ surahs and\nreal overlap data.\n\nUntil then a hand-ranked list of ~15 short,\nhigh-utility surahs beats any algorithm and\ntakes an afternoon. Ship that; earn the\nalgorithm later.",
      "originalText": "SCOPE WARNING\nThe recommender (step 30) is the piece most\nlikely to eat the project. It only becomes\nmeaningful once a learner has 2+ surahs and\nreal overlap data.\n\nUntil then a hand-ranked list of ~15 short,\nhigh-utility surahs beats any algorithm and\ntakes an afternoon. Ship that; earn the\nalgorithm later.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
