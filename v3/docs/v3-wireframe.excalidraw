      "width": 330,
      "height": 230
    },
    {
      "id": "el-375",
      "angle": 0,
      "strokeColor": "#712b13",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2977544,
      "version": 1,
      "versionNonce": 39378104,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1272,
      "y": 2612,
      "width": 297,
      "height": 195,
      "text": "THE CHAINING PROBLEM — you flagged this as\nthe trickiest part. It is, and the fix is to\nstop treating it as a property of ayat.\n\nA chain is a SEPARATE MEMORY OBJECT: the\njoint between ayah N and N+1, with its own\nstrength and its own review schedule.\n\nWhy this works: reciting ayah 3 perfectly and\nayah 4 perfectly does NOT mean you can go\nfrom 3 into 4 — the transition is a distinct\nretrieval. Most hifz apps miss this and\nlearners stall at exactly these joints.",
      "originalText": "THE CHAINING PROBLEM — you flagged this as\nthe trickiest part. It is, and the fix is to\nstop treating it as a property of ayat.\n\nA chain is a SEPARATE MEMORY OBJECT: the\njoint between ayah N and N+1, with its own\nstrength and its own review schedule.\n\nWhy this works: reciting ayah 3 perfectly and\nayah 4 perfectly does NOT mean you can go\nfrom 3 into 4 — the transition is a distinct\nretrieval. Most hifz apps miss this and\nlearners stall at exactly these joints.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "id": "el-376",
      "angle": 0,
      "strokeColor": "#ba7517",
      "backgroundColor": "#faeeda",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 2985463,
      "version": 1,
      "versionNonce": 39482833,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "rectangle",
      "x": 1260,
      "y": 2860,
      "width": 330,
      "height": 150
    },
    {
      "id": "el-377",
      "angle": 0,
      "strokeColor": "#7a4d0d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2993382,
      "version": 1,
      "versionNonce": 39587562,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1272,
      "y": 2872,
      "width": 297,
      "height": 120,
      "text": "A chain card only becomes eligible once BOTH\nits ayat are individually strong. Otherwise\nyou are testing a joint between two things\nthat do not yet exist.\n\nv2 already has this in engine/chain.ts —\nincluding BUG-3 (chains crediting un-learned\nayat), which v3 should inherit ALREADY FIXED.",
      "originalText": "A chain card only becomes eligible once BOTH\nits ayat are individually strong. Otherwise\nyou are testing a joint between two things\nthat do not yet exist.\n\nv2 already has this in engine/chain.ts —\nincluding BUG-3 (chains crediting un-learned\nayat), which v3 should inherit ALREADY FIXED.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "id": "el-378",
      "angle": 0,
      "strokeColor": "#adaba3",
