# dependencies
node_modules/
vendor/

# builds / caches
dist/
.vite/
.wrangler/
coverage/
*.log
.DS_Store

# SECRETS — never commit
.dev.vars
.env
.env.*
!.env.example
!.dev.vars.example

# preserved v1 git history backup (not part of this repo)
v1/.git.bak/

# synced build artifacts (canonical sources live elsewhere)
**/apps/web/public/iman-ui.css
**/apps/web/public/corpus.json
# v3: staged by apps/web/scripts/stage-corpus.mjs from the corpus-compiler's
# output/ tree, which is itself gitignored (v3-D52 — the corpus is a build
# artifact). Committing a copy would create a second source of truth that
# silently goes stale the next time the compiler runs.
**/apps/web/public/corpus/

# Laravel (v2/api, when scaffolded)
v2/api/vendor/
v2/api/.env
v2/api/storage/*.key
v2/api/storage/logs/
v2/api/storage/framework/cache/
v2/api/storage/framework/sessions/
v2/api/storage/framework/views/
v2/api/bootstrap/cache/
